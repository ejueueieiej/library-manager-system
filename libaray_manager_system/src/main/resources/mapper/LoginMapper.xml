<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.libaray_manager_system.mapper.LoginMapper">

    <!-- 按登录名查用户（登录用）
         resultType 写 sysUser：因为 application.yml 里配了
         type-aliases-package: org.libaray_manager_system.pojo.entity，
         所以实体类不用写全限定名，写类名就行（MyBatis 的别名查找不区分大小写）。

         ⚠️ 必须 SELECT 出 password 列！否则 BCrypt.checkpw 拿不到哈希，谁的密码都校验不过。
            （这里用 SELECT * 自然会带上；如果以后改成显式列名，别忘了 password） -->
    <select id="GetByUsername" resultType="sysUser">
        SELECT *
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 按主键查用户（「获取当前登录用户」用）
         同样 SELECT *：这个结果只在后端用，
         最终会被转成 UserVo（没有 password 字段）才返回给前端，所以不会泄露哈希。 -->
    <select id="GetById" resultType="sysUser">
        SELECT *
        FROM sys_user
        WHERE id = #{id}
        LIMIT 1
    </select>

</mapper>
